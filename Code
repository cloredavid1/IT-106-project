import javax.swing.JOptionPane;

public class BudgetAndCalories {
    public static void main(String[] args) {

        // INPUT
        double budget = Double.parseDouble(
                JOptionPane.showInputDialog("Enter food budget:"));

        double goal = Double.parseDouble(
                JOptionPane.showInputDialog("Enter calorie goal:"));

        double cost = Double.parseDouble(
                JOptionPane.showInputDialog("Enter meal cost:"));

        double eaten = Double.parseDouble(
                JOptionPane.showInputDialog("Enter calories eaten:"));

        double burned = Double.parseDouble(
                JOptionPane.showInputDialog("Enter calories burned:"));


        // PROCESS
        double moneyLeft = budget - cost;
        double caloriesLeft = goal - eaten + burned;


        // OUTPUT
        JOptionPane.showMessageDialog(null,
                "Money left: $" + moneyLeft +
                "\nCalories left: " + caloriesLeft);
    }
}

import javax.swing.JOptionPane;

public class BudgetAndCalories {
    public static void main(String[] args) {

        // Input
        String budgetInput = JOptionPane.showInputDialog("Enter your food budget:");
        double foodBudget = Double.parseDouble(budgetInput);

        String goalInput = JOptionPane.showInputDialog("Enter your calorie goal:");
        double calorieGoal = Double.parseDouble(goalInput);

        String costInput = JOptionPane.showInputDialog("Enter your meal cost:");
        double mealCost = Double.parseDouble(costInput);

        String caloriesInput = JOptionPane.showInputDialog("Enter calories eaten:");
        double caloriesEaten = Double.parseDouble(caloriesInput);

        String exerciseInput = JOptionPane.showInputDialog("Enter calories burned:");
        double exerciseCalories = Double.parseDouble(exerciseInput);

        // Process
        double remainingBudget = foodBudget - mealCost;
        double remainingCalories = calorieGoal - caloriesEaten + exerciseCalories;

        // Output
        JOptionPane.showMessageDialog(null,
                "Remaining budget: $" + remainingBudget +
                "\nCalories left: " + remainingCalories);
    }
}

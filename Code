import javax.swing.JOptionPane;

public class BudgetAndCalories {
    public static void main(String[] args) {

        /*
         * Budget and Calories Program
         *
         * This program allows the user to enter a food budget,
         * calorie goal, meal cost, calories eaten, and calories burned.
         *
         * The program calculates how much money is left in the budget
         * and how many calories the user has remaining.
         *
         * Input validation is used to prevent invalid entries.
         * The program also allows the user to run it multiple times.
         */

        boolean runAgain = true;

        while (runAgain) {

            try {

                // INPUT
                double budget = Double.parseDouble(
                        JOptionPane.showInputDialog("Enter food budget:"));

                double goal = Double.parseDouble(
                        JOptionPane.showInputDialog("Enter calorie goal:"));

                double costB = Double.parseDouble(
                        JOptionPane.showInputDialog("Enter breakfest meal cost:"));

                double eatenB = Double.parseDouble(
                        JOptionPane.showInputDialog("Enter breakfest calories eaten:"));
                
                double costL = Double.parseDouble(
                        JOptionPane.showInputDialog("Enter lunch meal cost:"));

                double eatenL = Double.parseDouble(
                        JOptionPane.showInputDialog("Enter lunch calories eaten:"));

                double costD = Double.parseDouble(
                        JOptionPane.showInputDialog("Enter dinner meal cost:"));

                double eatenD = Double.parseDouble(
                        JOptionPane.showInputDialog("Enter dinner calories eaten:"));

                double burned = Double.parseDouble(
                        JOptionPane.showInputDialog("Enter calories burned:"));


                // VALIDATION
                if (budget < 0 || goal < 0 || costB < 0 || costL < 0 || costD < 0 ||
                        eatenB < 0 || eatenL < 0 || eatenD < 0 || burned < 0) {

                    JOptionPane.showMessageDialog(null,
                            "Error: Numbers cannot be negative.");

                } else {

                    // PROCESS
                    double totalcost = costB + costL + costD;
                    double moneyLeft = budget - totalcost;
                    double totalcale = eatenB + eatenL + eatenD;
                    double caloriesLeft = goal - totalcale + burned;


                    // OUTPUT
                    String message = "Money left: $" + moneyLeft +
                            "\nCalories left: " + caloriesLeft;

                    // IF/ELSE STATEMENTS START
                    if (moneyLeft < 0) {
                        message += "\nYou are over your food budget.";
                    } else {
                        message += "\nYou are within your food budget.";
                    }

                    if (caloriesLeft < 0) {
                        message += "\nYou went over your calorie goal.";
                    } else {
                        message += "\nYou are within your calorie goal.";
                    } \\END

                    JOptionPane.showMessageDialog(null, message);
                }

            } catch (NumberFormatException e) {

                // ERROR IF USER ENTERS WORDS INSTEAD OF NUMBERS
                JOptionPane.showMessageDialog(null,
                        "Error: Please enter numbers only.");
            }


            // ASK USER IF THEY WANT TO RUN THE PROGRAM AGAIN
            int choice = JOptionPane.showConfirmDialog(
                    null,
                    "Would you like to run the program again?",
                    "Run Again",
                    JOptionPane.YES_NO_OPTION);

            if (choice == JOptionPane.NO_OPTION) {
                runAgain = false;
            }
        }

        JOptionPane.showMessageDialog(null,
                "Program ended.");
    }
}

import java.util.Scanner;

public class BudgetAndCalories {
    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        // Input: Ask the user for information
        System.out.print("Enter your food budget for today ($): ");
        double foodBudget = input.nextDouble();

        System.out.print("Enter your calorie goal for today: ");
        double calorieGoal = input.nextDouble();

        System.out.print("Enter the cost of your meal ($): ");
        double mealCost = input.nextDouble();

        System.out.print("Enter the calories in your meal: ");
        double caloriesEaten = input.nextDouble();

        System.out.print("Enter calories burned from exercise: ");
        double exerciseCalories = input.nextDouble();


        // Process: Calculate budget and calories
        double remainingBudget = foodBudget - mealCost;
        double totalSpent = mealCost;
        double caloriesConsumed = caloriesEaten;
        double remainingCalories = calorieGoal - caloriesEaten + exerciseCalories;


        // Output: Show the results
        System.out.println("\n--- Daily Summary ---");
        System.out.println("Remaining food budget: $" + remainingBudget);
        System.out.println("Total money spent: $" + totalSpent);
        System.out.println("Calories consumed: " + caloriesConsumed);
        System.out.println("Calories left for the day: " + remainingCalories);
    }
}
